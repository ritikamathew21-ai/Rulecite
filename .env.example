# Copy to .env.local and fill in locally. Never commit .env.local.
# On Vercel, set these in Project Settings > Environment Variables.

# AI provider (server only). Set to disabled to turn AI checks off.
AI_PROVIDER=gemini
# Create in Google AI Studio, in a project with no billing linked. Budget is zero.
# Never rename this with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional alternative: gemini-3.8-flash
AI_TIMEOUT_MS=45000

# Supabase (NEXT_PUBLIC_ values are visible in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security. Local scripts only, not the running app.
SUPABASE_SERVICE_ROLE_KEY=
# Local migrations only. Never add this to Vercel.
SUPABASE_DB_PASSWORD=
# Server only. Lets the app record check results, and nothing else. Set by npm run db:writer.
# Add this to Vercel. It is the only secret the running app uses.
CHECK_WRITER_SECRET=
# Fictional demo accounts. Generated by npm run db:seed. Local only.
DEMO_USER_PASSWORD=
