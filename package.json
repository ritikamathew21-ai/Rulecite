{
  "name": "rulecite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "db": "node --env-file=.env.local scripts/supabase-remote.mjs",
    "test:rls": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "db:seed": "node --env-file=.env.local scripts/seed-demo.mjs",
    "db:writer": "node --env-file=.env.local scripts/set-check-writer.mjs",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "jszip": "^3.10.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5"
  }
}
